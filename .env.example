# Copy to .env on your laptop:
#   cp .env.example .env
#
# scripts/launch.sh uploads .env to the instance when the file exists.
# .env is gitignored. Do not commit tokens.

# Hugging Face token. Required for gated models (Llama, Gemma, and similar).
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional shared secret for the vLLM OpenAI API.
# Leave empty to leave vLLM open on localhost only (the default).
VLLM_API_KEY=
